# OpenAI API (required for live AI gift recommendations)
# Get your key at: https://platform.openai.com/api-keys
AI_KEY=YOUR_OPENAI_API_KEY
AI_MODEL=gpt-4o

# Optional: Custom OpenAI-compatible API base URL (leave blank to use OpenAI directly)
AI_URL=

# Supabase (required for cloud auth + persistent wish history)
# Create a free project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
