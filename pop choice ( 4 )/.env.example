# Supabase (server-side; the service-role key must never reach the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI: Gemini for embeddings + generation
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
# Optional model overrides
# MODEL_FAST=gemini-3.5-flash-lite
# MODEL_SMART=gemini-3.8-flash

# Data pipeline (npm run pipeline)
OMDB_API_KEY=your-omdb-key          # free: 1,000 requests/day. https://www.omdbapi.com/apikey.aspx
CONTACT=you@example.com             # email or URL; Wikimedia requires it in the User-Agent
# EMBED_DELAY_MS=1000               # raise if Gemini returns 429s during load

# PopStream "where to watch" (free tier: 2,500 calls/month)
WATCHMODE_API_KEY=your-watchmode-key
WATCH_REGION=US
