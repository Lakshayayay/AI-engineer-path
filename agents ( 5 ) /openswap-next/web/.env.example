# Copy this file to .env.local and fill in the values. Next.js loads .env.local on its own.
# Required. Your OpenAI API key. Keep it on the server only.
OPENAI_API_KEY=
# Required. The model id to use, for example gpt-5.4-nano. It must support OpenAI's built-in web search.
AI_MODEL=
# Optional. A GitHub token gives the health check a much higher rate limit.
GITHUB_TOKEN=
# Required. Your Supabase project URL, for example https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Required. Your Supabase publishable key (starts with sb_publishable_). Safe to expose; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. A Discord channel webhook URL. Without it the send_to_discord tool tells the user Discord isn't set up.
DISCORD_WEBHOOK_URL=
